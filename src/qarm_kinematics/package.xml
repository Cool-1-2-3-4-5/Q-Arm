<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qarm_kinematics</name>
  <version>0.0.0</version>
  <description>
    Forward kinematics for the Quanser QArm, written in Python with numpy.
    Holds the single source of truth for the Denavit-Hartenberg parameters and a
    headless test that validates the FK against the TF tree published by
    robot_state_publisher from qarm_description's URDF.
  </description>
  <maintainer email="elilgrade8@gmail.com">watimake</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>qarm_description</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
