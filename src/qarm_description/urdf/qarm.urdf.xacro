<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="qarm">
    
    <!-- Link Lengths & Radii (Update with physical specs later) -->
    <xacro:property name="base_radius" value="0.05" />
    <xacro:property name="l1_len" value="0.15" />
    <xacro:property name="l2_len" value="0.35" />
    <xacro:property name="l3_len" value="0.25" />
    <xacro:property name="l4_len" value="0.10" />
    <xacro:property name="link_radius" value="0.03" />

    <!-- Materials -->
    <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
    <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

    <!-- Base Link -->
    <link name="base_link">
        <visual>
            <geometry><cylinder radius="${base_radius}" length="0.05"/></geometry>
            <material name="dark_gray"/>
        </visual>
    </link>

    <!-- Link 1 -->
    <link name="link_1">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${l1_len}"/></geometry>
            <origin xyz="0 0 ${l1_len/2}" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
    </link>

    <!-- Joint 1 (Roll - Base Pan) -->
    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.1415" upper="3.1415" effort="10.0" velocity="1.0"/>
    </joint>

    <!-- Link 2 -->
    <link name="link_2">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${l2_len}"/></geometry>
            <origin xyz="0 0 ${l2_len/2}" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <!-- Joint 2 (Pitch - Shoulder) -->
    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 ${l1_len}" rpy="0 1.5708 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
    </joint>

    <!-- Link 3 -->
    <link name="link_3">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${l3_len}"/></geometry>
            <origin xyz="0 0 ${l3_len/2}" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
    </link>

    <!-- Joint 3 (Pitch - Elbow) -->
    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 ${l2_len}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="10.0" velocity="1.0"/>
    </joint>

    <!-- Link 4 (End Effector Base) -->
    <link name="link_4">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${l4_len}"/></geometry>
            <origin xyz="0 0 ${l4_len/2}" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
    </link>

    <!-- Joint 4 (Roll - Wrist) -->
    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 ${l3_len}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.1415" upper="3.1415" effort="10.0" velocity="1.0"/>
    </joint>
</robot>