<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="qarm">

    <!-- ============================================================
         ARGUMENTS

         ros2_control       emit the <ros2_control> hardware block?
                            OFF by default, so display.launch.py and
                            every existing FK/IK validation script
                            keep generating byte-for-byte the same
                            URDF they always have. Only the control
                            bringup turns it on. A controls change
                            must not be able to disturb geometry that
                            is validated to 1e-16 m.

         use_mock_hardware  when ros2_control is on, pick the
                            hardware plugin: mock (default) or the
                            real Quanser driver.
         ============================================================ -->
    <xacro:arg name="ros2_control"      default="false" />
    <xacro:arg name="use_mock_hardware" default="true" />

    <!-- ============================================================
         QARM DIMENSIONS
         All lengths in meters, all angles in radians.

         INDEPENDENT PARAMETERS (transcribed numbers - edit these).
         Everything else in this file is computed from them, so the
         model can never drift out of self-consistency.
         ============================================================ -->
    <xacro:property name="L1" value="0.14" />   <!-- base (ground) to shoulder axis -->
    <xacro:property name="L2" value="0.35" />   <!-- upper arm, ALONG the shoulder axis direction -->
    <xacro:property name="L3" value="0.05" />   <!-- upper arm, PERPENDICULAR (the elbow kink) -->
    <xacro:property name="L4" value="0.25" />   <!-- forearm: elbow axis to wrist axis -->
    <xacro:property name="L5" value="0.15" />   <!-- wrist axis to end_effector reference point -->

    <!-- Distance from end_effector (where the fingers start) out to
         the fingertips. This is NOT a Table 2 number. The manual
         gives two reaches: Section D (0.7536 / 0.8936 m) matches our
         chain to end_effector exactly, and Section B (0.800 / 0.940 m)
         is larger by the same 46.4 mm in both directions, which can
         only be a constant tip extension. We read Section B as
         measured to the fingertips. Measure it on the hardware. Full
         derivation in docs/kinematics.md, "Reach reconciliation". -->
    <xacro:property name="L_gripper" value="0.046447" />

    <!-- Simulated gripper: two straight fingers that slide open and
         closed. Cosmetic stand-in for the real tendon-driven
         two-finger gripper (manual section E.ii); it does not affect
         the arm kinematics. finger_travel is per finger, so the gap
         between the fingers runs from 0 (closed) to 40 mm (open).
         Full stroke takes 1 s, from Table 7's gripper speed of
         100 percent per second. -->
    <xacro:property name="finger_travel"       value="0.02" />
    <xacro:property name="finger_thickness"    value="0.008" />
    <xacro:property name="finger_width"        value="0.02" />
    <xacro:property name="gripper_stroke_time" value="1.0" />

    <!-- ============================================================
         DERIVED PARAMETERS - DO NOT HAND-EDIT.

         Figure 3 of the manual labels the arm twice over:
           * L1..L5  are the RAW physical dimensions (Table 2).
           * lambda_i are the EFFECTIVE link lengths, i.e. the actual
             straight-line distance between two consecutive joint
             axes. Those are what a DH chain is built out of.

         For most links the two agree, but at the elbow they do not,
         because L2 and L3 are the two CARTESIAN COMPONENTS of one
         single vector: shoulder -> elbow. lambda_2 is that vector's
         LENGTH and beta is its ANGLE off vertical. So beta and L3 are
         two descriptions of THE SAME mechanical feature (the kink)
         and must never both be applied.

                  elbow
                    o
                   /|
                  / |  L2 = 0.35   (component along link_2's own z)
        lambda_2 /  |
                /   |
               / b  |   lambda_2 = sqrt(L2^2 + L3^2) = 0.353553 m
              o=====+   beta     = atan2(L3, L2)     = 8.1301 deg
          shoulder
               L3 = 0.05  (perpendicular component)

         AGREEMENT CHECK: the manual quotes beta = 8.13 deg in
         Table 2. atan2(0.05, 0.35) = 8.1301 deg, i.e. Table 2's value
         to the 2 decimals it is printed with. Computing it here
         instead of retyping it is what prevents the "applied twice"
         bug this file used to have (see docs/kinematics.md).
         ============================================================ -->
    <xacro:property name="lambda_1" value="${L1}" />                  <!-- base -> shoulder axis -->
    <xacro:property name="lambda_2" value="${sqrt(L2*L2 + L3*L3)}" /> <!-- shoulder -> elbow axis -->
    <xacro:property name="lambda_3" value="${L4}" />                  <!-- elbow -> wrist axis -->
    <xacro:property name="lambda_4" value="${L5}" />                  <!-- wrist -> end_effector -->
    <xacro:property name="beta"     value="${atan2(L3, L2)}" />

    <!-- ============================================================
         JOINT LIMITS
         Source: Quanser QArm user manual, Table 7 ("Joint range",
         "Max. speed").

         ZERO CONVENTION: every joint reads 0 at the manual's HOME
         POSE (Figure 3 / Figure 4b): upper arm up, forearm
         horizontal. Table 7's ranges are measured from that pose,
         and this model uses the same zero, so the values below are
         copied with no conversion. Still to confirm on hardware:
         in the home configuration the arm should report ~0 on all
         four joints.
         ============================================================ -->
    <xacro:property name="deg" value="${pi / 180.0}" />

    <xacro:property name="q1_min" value="${-170 * deg}" />
    <xacro:property name="q1_max" value="${ 170 * deg}" />
    <xacro:property name="q2_min" value="${ -85 * deg}" />
    <xacro:property name="q2_max" value="${  85 * deg}" />
    <xacro:property name="q3_min" value="${ -95 * deg}" />
    <xacro:property name="q3_max" value="${  75 * deg}" />
    <xacro:property name="q4_min" value="${-160 * deg}" />
    <xacro:property name="q4_max" value="${ 160 * deg}" />

    <xacro:property name="vel_max"    value="${90 * deg}" />  <!-- pi/2 rad/s, Table 7 row 2 -->

    <!-- ============================================================
         EFFORT LIMITS - Table 7 row 5, CONTINUOUS torque column.

         Table 7 quotes two torques per joint. The CONTINUOUS value
         is used here because a URDF effort limit is a steady-state
         ceiling, and the manual says of the instantaneous column:
         "Do not exceed the instantaneous current/torque limits for
         more than 0.1s." Quoting the burst figure as the limit would
         license a controller to sit at a value the hardware
         tolerates for a tenth of a second.

                           continuous   instantaneous
             base             2.65 Nm       10.6 Nm
             shoulder         5.30 Nm       21.2 Nm
             elbow            2.65 Nm       10.6 Nm
             wrist            1.00 Nm        4.1 Nm

         The shoulder is twice the base and elbow because it uses TWO
         XM540-W270-R servos where they use one (section E.i) - an
         internal consistency check on the table.

         These replace a single effort_max = 10.0 placeholder that
         applied to every joint. It was wrong in both directions at
         once: 4x too permissive at the wrist, 4x too strict at the
         shoulder.
         ============================================================ -->
    <xacro:property name="tau1_max" value="2.65" />  <!-- base     -->
    <xacro:property name="tau2_max" value="5.3"  />  <!-- shoulder -->
    <xacro:property name="tau3_max" value="2.65" />  <!-- elbow    -->
    <xacro:property name="tau4_max" value="1.0"  />  <!-- wrist    -->

    <!-- STILL A PLACEHOLDER, and deliberately so. Table 7 gives the
         gripper 0.5 Nm continuous, but that is a TORQUE at the
         XC430-W240-T motor. These finger joints are prismatic, so a
         URDF effort limit here is a FORCE in newtons. Converting
         needs the tendon radius and the two-link finger linkage
         (section E.ii), none of which the manual dimensions. Writing
         0.5 here would be a unit error dressed up as a datasheet
         value. -->
    <xacro:property name="finger_effort" value="10.0" />

    <!-- Cosmetic cylinder radius for arm links (does not affect kinematics) -->
    <xacro:property name="link_radius" value="0.03" />

    <!-- ============================================================
         COLLISION GEOMETRY - conventions, read before editing.

         Every <collision> below is the SAME primitive as the
         <visual> beside it, built from the same properties. Nothing
         here is an independent number, so a dimension change can
         never leave the collision shape behind.

         WHY THE SHAPES MATCH THE VISUALS EXACTLY: the visuals are
         already approximations of the real castings (a 30 mm
         cylinder standing in for a bent aluminium shell). Shrinking
         the collision shape below the drawn one would claim accuracy
         we do not have; inflating it would reject reachable poses.

         TWO LINKS DELIBERATELY HAVE NO COLLISION SHAPE:

           base_link      a bare reference frame at the mounting
                          plane. The real arm appears to bolt to the
                          top of an enclosure (see the manual cover),
                          which is NOT yet modelled - MEASURE IT.
                          Until then there is nothing honest to put
                          here, and an invented box would silently
                          reject poses for an obstacle of the wrong
                          size.

           end_effector   its blue sphere and yellow bar are
                          ORIENTATION MARKERS, not hardware. Giving a
                          debug marker physical bulk would reject
                          poses for a reason that does not exist on
                          the real arm. The fingers below are real
                          and do get collision shapes.

         The elbow marker sphere on link_2 is likewise omitted: the
         collision checker treats each cylinder as a CAPSULE, whose
         rounded end cap already fills that volume. Capsules are a
         conservative superset of the cylinders drawn here (a
         cylinder lies entirely inside the capsule of the same radius
         and length), so the check can only ever be pessimistic - it
         cannot miss a contact that the drawn geometry would have.
         ============================================================ -->

    <!-- ============================================================
         MATERIALS
         ============================================================ -->
    <material name="dark_gray"><color rgba="0.2 0.2 0.2 1.0"/></material>
    <material name="red">      <color rgba="0.8 0.1 0.1 1.0"/></material>
    <material name="blue">     <color rgba="0.1 0.3 0.9 1.0"/></material>
    <material name="yellow">   <color rgba="0.95 0.85 0.1 1.0"/></material>
    <material name="silver">   <color rgba="0.75 0.75 0.78 1.0"/></material>

    <!-- ============================================================
         BASE LINK (mounting point on worksurface, zero height)
         L1 is measured from the mounting plane to joint_2, so
         base_link has no vertical extent of its own.
         ============================================================ -->
    <link name="base_link"/>

    <!-- ============================================================
         LINK 1 - Base column (rotated by joint_1, the base roll)
         Extends upward by L1 to the shoulder axis.
         ============================================================ -->
    <link name="link_1">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${L1}"/></geometry>
            <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${link_radius}" length="${L1}"/></geometry>
            <origin xyz="0 0 ${L1/2}" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child  link="link_1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${q1_min}" upper="${q1_max}"
               effort="${tau1_max}" velocity="${vel_max}"/>
    </joint>

    <!-- ============================================================
         LINK 2 - Upper arm (rotated by joint_2, the shoulder pitch)

         At joint_2 = 0 link_2's own z points straight up along world
         Z. The elbow is NOT straight above the shoulder: it sits at
         (L3, 0, L2) in link_2, i.e. lambda_2 away at angle beta. The
         visual is drawn along that true line so RViz shows the real
         upper arm rather than a vertical stick that misses the elbow.
         ============================================================ -->
    <link name="link_2">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${lambda_2}"/></geometry>
            <origin xyz="${L3/2} 0 ${L2/2}" rpy="0 ${beta} 0"/>
            <material name="dark_gray"/>
        </visual>
        <!-- Marker at the elbow so the kink is visible -->
        <visual>
            <geometry><sphere radius="${link_radius * 0.95}"/></geometry>
            <origin xyz="${L3} 0 ${L2}" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>
        <!-- Follows the true shoulder->elbow line, like the visual.
             The elbow marker sphere is not repeated here; the
             capsule end cap covers it. -->
        <collision>
            <geometry><cylinder radius="${link_radius}" length="${lambda_2}"/></geometry>
            <origin xyz="${L3/2} 0 ${L2/2}" rpy="0 ${beta} 0"/>
        </collision>
    </link>

    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child  link="link_2"/>
        <origin xyz="0 0 ${L1}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${q2_min}" upper="${q2_max}"
               effort="${tau2_max}" velocity="${vel_max}"/>
    </joint>

    <!-- ============================================================
         LINK 3 - Forearm (rotated by joint_3, the elbow pitch)

         *** THE WHOLE ELBOW GEOMETRY LIVES IN THIS ONE <origin>. ***

         xyz="L3 0 L2"    places the elbow axis (the shoulder->elbow
                          vector, expressed in link_2's frame)
         rpy="0 pi/2 0"   sets the elbow's ZERO: at q3 = 0 the
                          forearm points along link_2's +x, square
                          to L2. With the shoulder at 0 that is the
                          manual's home pose, forearm horizontal
                          (Figure 3). Positive q3 swings the forearm
                          down toward the table.

         The arm is dead straight (forearm continuing along
         lambda_2) at q3 = beta - 90 deg = -81.87 deg. That is
         pi/2 = beta + (90 deg - beta): the structural beta is still
         in here exactly once, plus the 81.87 deg home-pose offset.

         This file previously split the elbow geometry across a
         separate 'elbow_offset' fixed joint AND this origin, which
         applied beta twice and shrank the upper arm from 353.6 mm
         to 346.5 mm. Keeping it in a single origin makes that class
         of bug structurally impossible: there is exactly one place
         the elbow geometry can be written. Do not add an
         intermediate fixed joint back in.
         ============================================================ -->
    <link name="link_3">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${L4}"/></geometry>
            <origin xyz="0 0 ${L4/2}" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${link_radius}" length="${L4}"/></geometry>
            <origin xyz="0 0 ${L4/2}" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child  link="link_3"/>
        <origin xyz="${L3} 0 ${L2}" rpy="0 ${pi / 2} 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="${q3_min}" upper="${q3_max}"
               effort="${tau3_max}" velocity="${vel_max}"/>
    </joint>

    <!-- ============================================================
         LINK 4 - Wrist housing and gripper body (rotated by joint_4,
         the wrist roll). The L5 cylinder is the gripper body; the
         palm crossbar at its end is what the fingers slide along.
         joint_4 is collinear with the forearm, so q4 changes
         orientation only, never end_effector position.
         ============================================================ -->
    <link name="link_4">
        <visual>
            <geometry><cylinder radius="${link_radius}" length="${L5}"/></geometry>
            <origin xyz="0 0 ${L5/2}" rpy="0 0 0"/>
            <material name="dark_gray"/>
        </visual>
        <!-- Gripper palm: wide enough to carry both fingers fully open -->
        <visual>
            <geometry>
                <box size="${finger_width} ${2 * (finger_travel + finger_thickness) + 0.01} 0.02"/>
            </geometry>
            <origin xyz="0 0 ${L5 - 0.01}" rpy="0 0 0"/>
            <material name="red"/>
        </visual>
        <collision>
            <geometry><cylinder radius="${link_radius}" length="${L5}"/></geometry>
            <origin xyz="0 0 ${L5/2}" rpy="0 0 0"/>
        </collision>
        <collision>
            <geometry>
                <box size="${finger_width} ${2 * (finger_travel + finger_thickness) + 0.01} 0.02"/>
            </geometry>
            <origin xyz="0 0 ${L5 - 0.01}" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child  link="link_4"/>
        <origin xyz="0 0 ${L4}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="${q4_min}" upper="${q4_max}"
               effort="${tau4_max}" velocity="${vel_max}"/>
    </joint>

    <!-- ============================================================
         END EFFECTOR - the FK/IK target frame.

         NOTE: this is the gripper reference point at the palm face,
         L5 past the wrist axis, where the fingers start. It is NOT
         the fingertip. Its position must never be changed: FK, IK
         and the saved RViz config all target this frame. If you want
         the fingertip, use gripper_tip below.
         ============================================================ -->
    <link name="end_effector">
        <!-- Sphere ON the axis -->
        <visual>
            <geometry><sphere radius="0.02"/></geometry>
            <material name="blue"/>
        </visual>
        <!-- Bar OFF the axis so joint_4 rotation is visually obvious -->
        <visual>
            <geometry><box size="0.01 0.08 0.01"/></geometry>
            <origin xyz="0 0.04 0" rpy="0 0 0"/>
            <material name="yellow"/>
        </visual>
    </link>

    <joint name="tool_tip" type="fixed">
        <parent link="link_4"/>
        <child  link="end_effector"/>
        <origin xyz="0 0 ${L5}" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================
         GRIPPER TIP - extra reference frame, NOT the FK/IK target.

         The fingertips, L_gripper past end_effector. With it, the
         manual's Section B reach is reproducible:
             horizontal: lambda_2 + lambda_3 + L_gripper
                         = 0.753553 + 0.046447 = 0.800 m
             vertical:   lambda_1 + lambda_2 + lambda_3 + L_gripper
                         = 0.893553 + 0.046447 = 0.940 m
         (Section D's 0.7536 / 0.8936 m are the same reaches measured
         to end_effector.) It lies ON the tool axis (+z of link_4), so
         like end_effector it is unaffected by the q4 roll, and it
         does not move when the fingers open or close.
         ============================================================ -->
    <link name="gripper_tip"/>

    <joint name="gripper_tip_joint" type="fixed">
        <parent link="end_effector"/>
        <child  link="gripper_tip"/>
        <origin xyz="0 0 ${L_gripper}" rpy="0 0 0"/>
    </joint>

    <!-- ============================================================
         FINGERS - two straight fingers running from end_effector out
         to gripper_tip (L_gripper long), sliding apart along the
         end_effector's y axis.

         finger_left_joint is the one real joint: 0 = closed (fingers
         touching), finger_travel = fully open. finger_right_joint
         MIMICS it, mirrored by its -y axis, so one number drives
         both fingers - like the real gripper, which moves both
         fingers with a single motor. The qarm_gripper node publishes
         this number when it receives an open/close command.
         ============================================================ -->
    <link name="finger_left">
        <visual>
            <geometry><box size="${finger_width} ${finger_thickness} ${L_gripper}"/></geometry>
            <origin xyz="0 0 ${L_gripper / 2}" rpy="0 0 0"/>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry><box size="${finger_width} ${finger_thickness} ${L_gripper}"/></geometry>
            <origin xyz="0 0 ${L_gripper / 2}" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="finger_left_joint" type="prismatic">
        <parent link="end_effector"/>
        <child  link="finger_left"/>
        <origin xyz="0 ${finger_thickness / 2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="${finger_travel}"
               effort="${finger_effort}" velocity="${finger_travel / gripper_stroke_time}"/>
    </joint>

    <link name="finger_right">
        <visual>
            <geometry><box size="${finger_width} ${finger_thickness} ${L_gripper}"/></geometry>
            <origin xyz="0 0 ${L_gripper / 2}" rpy="0 0 0"/>
            <material name="silver"/>
        </visual>
        <collision>
            <geometry><box size="${finger_width} ${finger_thickness} ${L_gripper}"/></geometry>
            <origin xyz="0 0 ${L_gripper / 2}" rpy="0 0 0"/>
        </collision>
    </link>

    <joint name="finger_right_joint" type="prismatic">
        <parent link="end_effector"/>
        <child  link="finger_right"/>
        <origin xyz="0 ${-finger_thickness / 2} 0" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="0.0" upper="${finger_travel}"
               effort="${finger_effort}" velocity="${finger_travel / gripper_stroke_time}"/>
        <mimic joint="finger_left_joint" multiplier="1.0" offset="0.0"/>
    </joint>

    <!-- ============================================================
         ros2_control HARDWARE BLOCK

         Instantiated LAST, and only on request. Last because the
         macro reads the joint-limit properties (q1_min and friends)
         defined above, so they have to exist before it expands.
         Only on request because the default URDF must stay exactly
         what it was before ros2_control entered the project.
         ============================================================ -->
    <xacro:if value="$(arg ros2_control)">
        <xacro:include filename="$(find qarm_description)/urdf/qarm.ros2_control.xacro"/>
        <xacro:qarm_ros2_control
            name="QArmSystem"
            use_mock_hardware="$(arg use_mock_hardware)"/>
    </xacro:if>

</robot>
