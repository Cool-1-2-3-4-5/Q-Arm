{
  "name": "QArm ROS 2 Dev",
  "image": "ros:humble",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "remoteUser": "root",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/root/.ssh,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y ros-humble-desktop-full python3-colcon-common-extensions"
}
